# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# JWT_SECRET must be Base64-encoded and decode to at least 32 bytes.
JWT_SECRET=
# Use a random value of at least 32 characters.
OTP_SECRET=

# Optional: required only for email delivery (for example, verification codes).
MAIL_USERNAME=
MAIL_PASSWORD=

# Initial administrator account created on first application startup.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
